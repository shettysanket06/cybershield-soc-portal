# Copy this file to .env only for local development, then replace every placeholder.
# Never commit .env or a real database connection string.

# SQLite is the default, simplest local backend.
CYBERSHIELD_DB_BACKEND=sqlite
CYBERSHIELD_SECRET_KEY=replace-with-a-long-random-secret-before-use
CYBERSHIELD_HTTPS=0
CYBERSHIELD_CSRF_SECONDS=3600

# Optional: configure MongoDB only if you are intentionally using it.
# Keep credentials private. Do not paste an Atlas URI into GitHub or screenshots.
# MONGODB_URI=mongodb://127.0.0.1:27017/
# MONGODB_DB_NAME=cybershield

# Optional demo-account overrides. Replace placeholders before use.
# If these variables are not set, the app uses the documented local-lab demo accounts.
# CYBERSHIELD_ADMIN_USER=admin
# CYBERSHIELD_ADMIN_PASSWORD=replace-me
# CYBERSHIELD_ADMIN_EMAIL=admin@cybershield.local
# CYBERSHIELD_ANALYST_USER=analyst
# CYBERSHIELD_ANALYST_PASSWORD=replace-me
# CYBERSHIELD_ANALYST_EMAIL=analyst@cybershield.local
# CYBERSHIELD_EMPLOYEE_USER=john
# CYBERSHIELD_EMPLOYEE_PASSWORD=replace-me
# CYBERSHIELD_EMPLOYEE_EMAIL=john@cybershield.local
